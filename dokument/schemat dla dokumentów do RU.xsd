<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ru="https://www.gov.pl/static/zagospodarowanieprzestrzenne/schemas/ru/1.0" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:gmlexr="http://www.opengis.net/gml/3.3/exr" targetNamespace="https://www.gov.pl/static/zagospodarowanieprzestrzenne/schemas/ru/1.0" elementFormDefault="qualified" version="1.0">	<import namespace="http://www.opengis.net/gml/3.2" schemaLocation="http://schemas.opengis.net/gml/3.2.1/gml.xsd"/>	<import namespace="http://www.opengis.net/gml/3.3/exr" schemaLocation="http://schemas.opengis.net/gml/3.3/extdEncRule.xsd"/>	<!--//==========================================================================================================================================================================//-->	<element name="LokalizacjaDokumentu" type="ru:LokalizacjaDokumentuType" substitutionGroup="gml:AbstractFeature">		<annotation>			<documentation>Lokalizacja dokumentu: Przestrzenna reprezentacja (zasięg) dokumentu.</documentation>		</annotation>	</element>	<complexType name="LokalizacjaDokumentuType">		<complexContent>			<extension base="gml:AbstractFeatureType">				<sequence>					<element name="lokalnyIdDokumentu" type="string">						<annotation>							<documentation>identyfikator lokalny dokumentu: Identyfikator lokalny dokumentu, o którym mowa w § 5 ust. 1 pkt 2 oraz § 5 ust. 1a rozporządzenia, przypisany przez dostawcę danych.</documentation>						</annotation>					</element>					<element name="geometria" type="gml:MultiSurfacePropertyType">						<annotation>							<documentation>geometria: Obszar do którego odnosi się dokument.</documentation>						</annotation>					</element>				</sequence>			</extension>		</complexContent>	</complexType>	<complexType name="LokalizacjaDokumentuPropertyType">		<sequence minOccurs="0">			<element ref="ru:LokalizacjaDokumentu"/>		</sequence>		<attributeGroup ref="gml:AssociationAttributeGroup"/>		<attributeGroup ref="gml:OwnershipAttributeGroup"/>	</complexType></schema>