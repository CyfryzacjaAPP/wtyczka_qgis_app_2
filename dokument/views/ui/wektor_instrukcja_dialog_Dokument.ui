           <property name="font">
            <font>
             <stylestrategy>PreferDefault</stylestrategy>
            </font>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Formularz przeznaczony jest do tworzenia przestrzennej reprezentacji (zasięgu) dokumentu dedykowanego do udostępnienia w Repozytorium Rejestru Urbanistycznego. Należy wpisać identyfikator lokalny dokumentu oraz wybrać warstwę z geometrią.&lt;/p&gt;&lt;hr/&gt;&lt;p&gt;W zależności od aktualnego stanu pracy nad dokumentem, wybierz jedną z opcji: &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol';&quot;&gt;·	&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Stwórz pustą warstwę&lt;/span&gt;, która umożliwia stworzenie pustej warstwy w układzie współrzędnych PL-1992, dodanie obiektów przestrzennych, a następnie zapisanie warstwy do pliku GML/XML; &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol';&quot;&gt;·	&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Wczytaj warstwę do edycji&lt;/span&gt;, która umożliwia wczytanie wcześniej przygotowanej warstwy o rozszerzeniu GML/XML z obiektami przestrzennymi, a następnie jej edycję. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Identyfikator lokalny dokumentu w Repozytorium&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Aptos','sans-serif'; font-weight:600;&quot;&gt;Wybierz warstwę z geometrią - lokalizacją przestrzenną dotyczącą dokumentu&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignJustify|Qt::AlignVCenter</set>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="openExternalLinks">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
